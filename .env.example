# Copy to .env. Never commit .env.
# DJANGO_ENV: local | staging | production
DJANGO_ENV=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# PostgreSQL (docker compose service "db"; from the host use localhost)
POSTGRES_DB=zapik
POSTGRES_USER=zapik
POSTGRES_PASSWORD=zapik
DATABASE_URL=postgres://zapik:zapik@localhost:5432/zapik

# Notifications (prototype logs SMS to console)
SMS_BACKEND=apps.notifications.backends.LogSmsBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
LOG_LEVEL=INFO
