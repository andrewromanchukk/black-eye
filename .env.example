# Optional. `docker compose up` works without .env (defaults are in docker-compose.yml).
# Copy to .env to override. Never commit .env.
# DJANGO_ENV: local | staging | production
DJANGO_ENV=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# Golden base image for the web image (docs/registry-guide.md). Default without .env: zapik-base:local (built manually).
# Published image: tag for people, digest pins the exact build.
BASE_IMAGE=docker.io/andrewromanchukk/zapik-base:py3.13.18-trixie-20261117@sha256:7dfc9d09795bf8753f71bf663281afdb67a9269e6e9c95c89171a9f8f2940ef9

# PostgreSQL (docker compose service "db"; from the host use localhost)
POSTGRES_DB=zapik
POSTGRES_USER=zapik
POSTGRES_PASSWORD=zapik
DATABASE_URL=postgres://zapik:zapik@localhost:5432/zapik

# Notifications. Local: SMS go to the console. Pilot/production: SmsapiBackend + token.
SMS_BACKEND=apps.notifications.backends.LogSmsBackend
# SMS_BACKEND=apps.notifications.backends.SmsapiBackend
SMSAPI_TOKEN=
SMSAPI_SENDER=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
LOG_LEVEL=INFO
